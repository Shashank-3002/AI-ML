   "source": [
    "def reverse_string(s):\n",
    "    return s[::-1]\n",
    "\n",
    "# Read number of test cases\n",
    "t = int(input())\n",
    "for _ in range(t):\n",
    "    input_string = input()\n",
    "    reversed_string = reverse_string(input_string)\n",
    "    print(f\"Reversed string: {reversed_string}\")"
   ]
